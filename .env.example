# Copy to .env and change the placeholder values. .env is git-ignored. Never commit real secrets.

PHARMAVIQUE_ENVIRONMENT=dev
PHARMAVIQUE_LOG_LEVEL=INFO

# Used by docker compose to create the local Postgres container
POSTGRES_USER=pharmavique
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=pharmavique

# Used by the application (wired in Phase 1). Keep the password in sync with the line above.
PHARMAVIQUE_DATABASE_URL=postgresql+asyncpg://pharmavique:change-me-dev-only@localhost:5432/pharmavique
PHARMAVIQUE_REDIS_URL=redis://127.0.0.1:6379/0

# Source credentials arrive in Phase 1 (read from the environment, never hardcoded or logged):
# PHARMAVIQUE_SFDA_API_KEY=

# AI providers (ADR-005). Put real keys only in .env, never here.
PHARMAVIQUE_OPENROUTER_API_KEY=
PHARMAVIQUE_GROQ_API_KEY=
PHARMAVIQUE_DEEPGRAM_API_KEY=
PHARMAVIQUE_ELEVENLABS_API_KEY=
# Embeddings through an OpenAI-compatible endpoint (OpenRouter by default, ADR-006)
PHARMAVIQUE_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
PHARMAVIQUE_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
PHARMAVIQUE_EMBEDDING_DIMENSIONS=1024

# Assistant language model (needs tool calling): groq (default) or openrouter
PHARMAVIQUE_LLM_PROVIDER=groq
PHARMAVIQUE_LLM_MODEL=openai/gpt-oss-120b
# Vision models for box and prescription scans (OpenRouter), tried in order
PHARMAVIQUE_VISION_MODELS=["nvidia/nemotron-3.5-super-vl:free","google/gemma-4-31b-it:free","inclusionai/ling-3.2-flash:free"]
# Speech: Whisper (Groq) for speech to text; Saudi Arabic voice through ElevenLabs (or groq)
PHARMAVIQUE_STT_MODEL=whisper-large-v3-turbo
PHARMAVIQUE_TTS_PROVIDER=elevenlabs
PHARMAVIQUE_ELEVENLABS_MODEL=eleven_v3
# Pick a Saudi Arabic voice in the ElevenLabs voice library and put its id here
PHARMAVIQUE_ELEVENLABS_VOICE_ID=

# Signs access tokens for accounts: at least 32 random characters, for example the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PHARMAVIQUE_JWT_SECRET=
