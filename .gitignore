# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
.import_linter_cache/

# Secrets and local config: never commit
.env
.env.*
!.env.example

# Uploads stay local (health data). The SFDA dataset under data/ is versioned (owner's decision,
# 2026-11-19) so every machine has the same data; keep each file under GitHub's 100 MB limit.
/uploads/
/data/lists-trial/
# The pharmacy catalogs' pictures and run files stay on this machine (tens of GB); the listings
# themselves are in the local database.
/data/offers/
# Run logs and one-off backups of the crawl and picture jobs (the data files themselves are kept).
/data/**/*.log
/data/**/*.stdout
/data/**/*.stderr
/data/media-demo/
# Daily refresh snapshots live in the database, not in git; the committed baseline is
# lists-1 and full-20261116. Lists that were started and stopped are not part of the dataset.
/data/lists/*/lists-20*/
/data/sfda/update-*/
/data/lists/marketed-products/
/data/lists/periodic-safety/
/data/lists/evaluation-reports/
/data/lists/*/*/crawl.log
/data/media/*.log
/data/media/*.stdout
/data/media/*.prev
/data/media/*.bak
/data/media/*.pre-*
/data/media/restore-report.json
/data/refresh/
/data/knowledge/*.log
/data/lists/*.log

