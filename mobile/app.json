{
  "expo": {
    "name": "Pharmavique",
    "slug": "pharmavique",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pharmavique",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F9F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F9F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "فارماڤيك محتاج الكاميرا عشان يقرا اسم الدواء من العلبة أو الروشتة. الصورة مش بتتحفظ.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "فارماڤيك محتاج الميكروفون عشان تسأل بصوتك. الصوت مش بيتحفظ."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "فارماڤيك محتاج الصور عشان تختار صورة علبة دواء أو روشتة."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "فارماڤيك بيستخدم موقعك مرة واحدة عشان يدلّك على أقرب مدن فيها صيدليات مرخّصة. الموقع مش بيتخزّن.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
