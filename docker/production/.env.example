# Copy to docker/production/.env (git-ignored) and fill in. Names only here, never values.
PHARMAVIQUE_IMAGE_TAG=latest

# Postgres behind PgBouncer (a managed Postgres, or Neon's direct address host)
DB_HOST=
DB_PORT=5432
DB_NAME=pharmavique
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
PGBOUNCER_POOL_SIZE=20
# Direct (unpooled) address for migrations, as the provider shows it
MIGRATE_DATABASE_URL=

# Same application settings as Vercel (see the root .env.example for the full list)
PHARMAVIQUE_JWT_SECRET=
PHARMAVIQUE_PUBLIC_URL=
PHARMAVIQUE_CORS_ORIGINS=
PHARMAVIQUE_EMAIL_BACKEND=
PHARMAVIQUE_EMAIL_FROM=
PHARMAVIQUE_SMTP_HOST=
PHARMAVIQUE_SMTP_PORT=
PHARMAVIQUE_SMTP_USERNAME=
PHARMAVIQUE_SMTP_PASSWORD=
PHARMAVIQUE_OPENROUTER_API_KEY=
PHARMAVIQUE_GROQ_API_KEY=
PHARMAVIQUE_SENTRY_DSN=
PHARMAVIQUE_TRUSTED_PROXY_HOPS=1
